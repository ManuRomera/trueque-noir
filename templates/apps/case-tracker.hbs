<div class="tn-panel">

  <header class="tn-panel__head">
    <div class="tn-panel__title">
      <span class="tn-kicker">La Ciudad dirige</span>
      <h1 data-case-name>{{caseName}}</h1>
      <p class="tn-panel__time" data-case-time>Día {{day}} de {{timeLimit}} · {{phase}}</p>
    </div>
    <div class="tn-panel__quick">
      <button type="button" class="tn-btn" data-action="prev-phase" title="Retroceder a la franja anterior"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Franja</button>
      <button type="button" class="tn-btn tn-btn--primary" data-action="next-phase" title="Avanzar a la siguiente franja">Franja <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
      <button type="button" class="tn-btn tn-btn--ghost" data-action="toggle-board" title="Mostrar u ocultar la Mesa del caso para todo el grupo">
        <i class="fa-solid {{#if displayVisible}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i>
        {{#if displayVisible}}Ocultar mesa{{else}}Mostrar mesa{{/if}}
      </button>
    </div>
  </header>

  <section class="tn-case-edit" aria-label="Datos del caso">
    <div class="tn-field tn-field--grow">
      <label for="tn-case-name">Caso</label>
      <input id="tn-case-name" type="text" data-setting="caseName" value="{{caseName}}" />
    </div>
    <div class="tn-field tn-field--num">
      <label for="tn-case-day">Día</label>
      <input id="tn-case-day" type="number" data-setting="caseDay" value="{{day}}" min="1" />
    </div>
    <div class="tn-field tn-field--num">
      <label for="tn-case-limit">Límite</label>
      <input id="tn-case-limit" type="number" data-setting="timeLimit" value="{{timeLimit}}" min="1" />
    </div>
    <div class="tn-field tn-field--num">
      <label>Franja</label>
      <output class="tn-output">{{phase}}</output>
    </div>
    <p class="tn-autosave"><i class="fa-solid fa-check" aria-hidden="true"></i> Se guarda solo</p>
  </section>

  <div class="tn-panel__row">

    <section class="tn-crime {{#if crimeExploded}}is-exploded{{/if}}" aria-label="Dado del crimen">
      <span class="tn-crime__label">Dado del crimen</span>
      <div class="tn-crime__control">
        <button type="button" class="tn-btn tn-btn--icon" data-action="crime-dec" {{#unless crimeCanFall}}disabled title="El dado del crimen ya está en 1."{{/unless}}>−</button>
        <output class="tn-crime__value">{{crimeDie}}</output>
        <button type="button" class="tn-btn tn-btn--icon" data-action="crime-inc" {{#unless crimeCanRise}}disabled title="El dado del crimen ya ha explotado."{{/unless}}>+</button>
      </div>
      {{#if canSpendClues}}
        <button type="button" class="tn-btn tn-btn--contextual tn-crime__spend" data-action="apply-clues">
          Usar {{cluesPerStep}} pistas → reducir a {{crimeAfterClues}}
        </button>
      {{else}}
        <p class="tn-crime__hint">Cada {{cluesPerStep}} pistas sin gastar bajan el dado automáticamente.</p>
      {{/if}}
      {{#if crimeExploded}}
        <p class="tn-crime__boom"><i class="fa-solid fa-burst" aria-hidden="true"></i> El dado ha explotado: el caso se cierra abruptamente.</p>
      {{/if}}
      <details class="tn-fold tn-fold--tight" data-section="crime-edit">
        <summary>Corregir el valor</summary>
        <div class="tn-crime__set">
          <button type="button" class="tn-btn" data-action="crime-set" data-value="1">1</button>
          <button type="button" class="tn-btn" data-action="crime-set" data-value="2">2</button>
          <button type="button" class="tn-btn" data-action="crime-set" data-value="3">3</button>
          <button type="button" class="tn-btn" data-action="crime-set" data-value="4">4</button>
        </div>
      </details>
    </section>

    <section class="tn-clues-panel" aria-label="Pistas del caso">
      <span class="tn-clues-panel__label">Pistas del caso</span>
      <div class="tn-clues-panel__grid">
        <div><strong>{{clueTotal}}</strong><span>descubiertas</span></div>
        <div><strong>{{clueSpent}}</strong><span>gastadas</span></div>
        <div class="is-key"><strong>{{clueAvailable}}</strong><span>sin gastar</span></div>
      </div>
      {{#if rumorBonusAvailable}}
        <div class="tn-rumor tn-rumor--panel">
          <span class="tn-rumor__kicker">Rumor pendiente</span>
          <p>{{rumorBonusText}}</p>
        </div>
      {{/if}}
    </section>

  </div>

  <div class="tn-folds">

    <details class="tn-fold" data-section="city">
      <summary><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> La ciudad · {{city.cityName}}</summary>
      <div class="tn-fold__body">
        <div class="tn-fold__actions">
          <button type="button" class="tn-btn tn-btn--contextual" data-action="edit-city"><i class="fa-solid fa-pen" aria-hidden="true"></i> {{#if city.hasContent}}Editar la ciudad{{else}}Construir la ciudad{{/if}}</button>
          {{#if city.hasContent}}<button type="button" class="tn-btn tn-btn--ghost" data-action="clear-city"><i class="fa-solid fa-eraser" aria-hidden="true"></i> Vaciar</button>{{/if}}
        </div>
        {{#if city.context}}
          <p class="tn-city__context">{{city.context}}</p>
        {{else}}
          <p class="tn-empty">Todavía no hay ciudad. El asistente la crea en tres pasos y la deja lista aquí.</p>
        {{/if}}
        {{#if city.hasZones}}
          <div class="tn-zones">
            {{#each city.zones}}
              <article class="tn-zone">
                <span class="tn-zone__compass">{{zone}}</span>
                <strong class="tn-zone__name">{{name}}</strong>
                <small class="tn-zone__traits">{{traits}}</small>
                <small class="tn-zone__controller">Controla: {{controller}}</small>
                <em class="tn-zone__extra">{{extra}}</em>
              </article>
            {{/each}}
          </div>
          <div class="tn-city__limits">
            <p><strong>Queremos ver.</strong> {{city.wanted}}</p>
            <p><strong>No queremos ver.</strong> {{city.unwanted}}</p>
          </div>
        {{/if}}
      </div>
    </details>

    <details class="tn-fold" data-section="detectives">
      <summary><i class="fa-solid fa-user-secret" aria-hidden="true"></i> Detectives</summary>
      <div class="tn-fold__body">
        {{#if detectives.length}}
          <div class="tn-field">
            <label for="tn-detective">Actúa sobre</label>
            <select id="tn-detective" name="selectedDetective">
              {{#each detectives}}
                <option value="{{id}}" {{#if (eq ../selectedDetective id)}}selected{{/if}}>{{name}} · {{cigarettes}} cig.{{#if states}} · {{states}}{{/if}}</option>
              {{/each}}
            </select>
          </div>
          <div class="tn-fold__actions tn-fold__actions--grid">
            <button type="button" class="tn-btn" data-action="quiet-drink"><i class="fa-solid fa-whiskey-glass" aria-hidden="true"></i> Un trago tranquilo</button>
            <button type="button" class="tn-btn" data-action="night-rest"><i class="fa-solid fa-moon" aria-hidden="true"></i> Descanso nocturno</button>
            <button type="button" class="tn-btn" data-action="recognition-plus"><i class="fa-solid fa-medal" aria-hidden="true"></i> +1 reconocimiento</button>
            <button type="button" class="tn-btn" data-action="interlude"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> Interludio</button>
          </div>
        {{else}}
          <p class="tn-empty">No hay detectives en la ciudad todavía.</p>
          <button type="button" class="tn-btn tn-btn--contextual" data-action="create-detective"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Crear un detective</button>
        {{/if}}
      </div>
    </details>

    <details class="tn-fold" data-section="trueque">
      <summary><i class="fa-solid fa-right-left" aria-hidden="true"></i> Trueque</summary>
      <div class="tn-fold__body">
        <button type="button" class="tn-btn tn-btn--contextual" data-action="random-trueque"><i class="fa-solid fa-dice" aria-hidden="true"></i> Proponer un trueque al azar</button>
        <div class="tn-trueque">
          <div>
            <h3>La ciudad se revuelve</h3>
            <ul>{{#each cityConsequences}}<li>{{this}}</li>{{/each}}</ul>
          </div>
          <div>
            <h3>Pagar el precio</h3>
            <ul>{{#each priceConsequences}}<li>{{this}}</li>{{/each}}</ul>
          </div>
        </div>
      </div>
    </details>

    <details class="tn-fold" data-section="accusation">
      <summary><i class="fa-solid fa-gavel" aria-hidden="true"></i> Acusación</summary>
      <div class="tn-fold__body">
        <p class="{{#unless canAccuse}}tn-warning{{/unless}}">
          El grupo lleva <strong>{{clueTotal}}</strong> pistas.
          {{#if canAccuse}}Ya puede acusar.{{else}}El manual pide {{cluesForAccusation}} antes de detener a nadie.{{/if}}
        </p>
        <button type="button" class="tn-btn tn-btn--contextual" data-action="accusation"><i class="fa-solid fa-handcuffs" aria-hidden="true"></i> Abrir la acusación</button>
      </div>
    </details>

    <details class="tn-fold tn-fold--admin" data-section="admin">
      <summary><i class="fa-solid fa-sliders" aria-hidden="true"></i> Administración</summary>
      <div class="tn-fold__body">
        <div class="tn-fold__actions">
          <button type="button" class="tn-btn tn-btn--ghost" data-action="open-welcome"><i class="fa-solid fa-door-open" aria-hidden="true"></i> Volver a la bienvenida</button>
          <button type="button" class="tn-btn tn-btn--ghost" data-action="import-cases"><i class="fa-solid fa-folder-tree" aria-hidden="true"></i> {{#if caseArchiveImported}}Revisar el archivo de casos{{else}}Importar el archivo de casos{{/if}}</button>
        </div>
        <div class="tn-danger">
          <h3>Reiniciar el caso</h3>
          <p>Borra el progreso de tiempo, pistas, rumor y recursos gastados. La ciudad y los detectives se conservan.</p>
          <button type="button" class="tn-btn tn-btn--danger" data-action="reset-case"><i class="fa-solid fa-trash-can" aria-hidden="true"></i> Reiniciar caso</button>
        </div>
      </div>
    </details>

  </div>
</div>
