<form class="tn-sheet detective-sheet {{cssClass}}" autocomplete="off">
  <section class="tn-topbar tn-panel-card tn-topbar-compact">
    <div class="tn-topbar-main">
      <img class="profile-img tn-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      <div class="tn-identity">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Nombre del detective" class="tn-name-inline" />
        <div class="tn-meta-row">
          <span class="tn-badge">Detective</span>
          <input type="text" name="system.roleTag" value="{{system.roleTag}}" placeholder="Tipo / apodo / función" class="tn-type-inline" />
        </div>
      </div>
    </div>

    <div class="tn-case-strip" aria-label="Estado del caso">
      <div class="tn-case-context"><span>Expediente</span><strong>{{caseName}}</strong><small>Día {{caseDay}} · {{casePhase}}</small></div>
      <div class="tn-vital tn-vital-cigarettes" title="Cigarrillos disponibles">
        <img src="systems/trueque-noir/assets/cigarette-v1.png" alt="" />
        <span>Cig.</span><strong>{{system.cigarettes.value}}/{{system.cigarettes.max}}</strong>
      </div>
      <div class="tn-vital"><span>Recon.</span><strong>{{availableRecognition}}</strong></div>
      <div class="tn-vital tn-vital-crime"><span>Crimen</span><strong>{{crimeDie}}</strong></div>
      <div class="tn-vital"><span>Pistas</span><strong>{{groupClues}}</strong><small>{{groupCluesAvailable}} guardadas</small></div>
    </div>

    <div class="tn-quick-actions">
      <button type="button" class="tn-primary-action" data-action="roll-risk"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Riesgo</button>
      <button type="button" class="tn-primary-action" data-action="roll-pursue"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Crimen</button>
      {{#if isGM}}
        <button type="button" data-action="open-city-tools">Ciudad</button>
        <button type="button" data-action="open-case-board">Mesa</button>
      {{/if}}
    </div>
  </section>

  <nav class="tn-tabs sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="document">Documento</a>
    <a class="item" data-tab="resources">Investigación</a>
    <a class="item" data-tab="notes">Notas</a>
  </nav>

  <section class="tn-overexpose-bar {{#unless canOverexpose}}is-muted{{/unless}}" aria-label="Sobreexposición">
    <span><strong>¿No aceptarás el resultado?</strong> Repite la última tirada aumentando la tensión de un pilar.</span>
    <button type="button" data-action="overexpose-person" {{#unless canOverexpose}}disabled{{/unless}}>Exponer persona</button>
    <button type="button" data-action="overexpose-place" {{#unless canOverexpose}}disabled{{/unless}}>Exponer lugar</button>
  </section>

  <section class="tn-body tn-main-body">
    <div class="tab tn-tab-document" data-group="primary" data-tab="document">
      <div class="tn-grid tn-doc-layout">
        <section class="tn-panel-card tn-profile-card">
          <div class="tn-section-title">Perfil</div>

          <div class="tn-field-grid tn-bg-grid">
            <div class="tn-field-group">
              <label>Trasfondo 1</label>
              <select name="system.background1" title="{{system.background1}}">
                <option value=""></option>
                {{#each allBackgrounds as |bg|}}
                  <option value="{{bg}}" {{#if (eq ../system.background1 bg)}}selected{{/if}}>{{bg}}</option>
                {{/each}}
              </select>
            </div>
            <div class="tn-field-group">
              <label>Trasfondo 2</label>
              <select name="system.background2" title="{{system.background2}}">
                <option value=""></option>
                {{#each allBackgrounds as |bg|}}
                  <option value="{{bg}}" {{#if (eq ../system.background2 bg)}}selected{{/if}}>{{bg}}</option>
                {{/each}}
              </select>
            </div>
            <div class="tn-field-group">
              <label>Extra</label>
              <select name="system.background3" title="{{system.background3}}">
                <option value=""></option>
                {{#each allBackgrounds as |bg|}}
                  <option value="{{bg}}" {{#if (eq ../system.background3 bg)}}selected{{/if}}>{{bg}}</option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="tn-field-grid tn-three-col">
            <div class="tn-field-group">
              <label>Físico</label>
              <input type="text" name="system.look" value="{{system.look}}" />
            </div>
            <div class="tn-field-group">
              <label>Creencias</label>
              <input type="text" name="system.belief" value="{{system.belief}}" />
            </div>
            <div class="tn-field-group">
              <label>Carácter</label>
              <input type="text" name="system.temperament" value="{{system.temperament}}" />
            </div>
          </div>

          <div class="tn-field-grid tn-two-col">
            <div class="tn-field-group">
              <label>Edad</label>
              <input type="text" name="system.age" value="{{system.age}}" />
            </div>
            <div class="tn-field-group">
              <label>Motivación</label>
              <input type="text" name="system.motivation" value="{{system.motivation}}" />
            </div>
          </div>
        </section>

        <section class="tn-panel-card tn-stability-card">
          <div class="tn-section-title">Pilares</div>
          <div class="tn-field-grid tn-one-col">
            <div class="tn-compact-box">
              <label>Persona</label>
              <input type="text" name="system.stability.person.name" value="{{system.stability.person.name}}" />
              <div class="tn-inline-controls tn-compact-controls tn-mini-controls">
                <span class="tn-inline-label">Tensión</span>
                <input type="number" data-dtype="Number" name="system.stability.person.tension" value="{{system.stability.person.tension}}" min="0" max="3" />
                <button type="button" data-action="increase-person-tension">+1</button>
              </div>
            </div>
            <div class="tn-compact-box">
              <label>Lugar</label>
              <input type="text" name="system.stability.place.name" value="{{system.stability.place.name}}" />
              <div class="tn-inline-controls tn-compact-controls tn-mini-controls">
                <span class="tn-inline-label">Tensión</span>
                <input type="number" data-dtype="Number" name="system.stability.place.tension" value="{{system.stability.place.tension}}" min="0" max="3" />
                <button type="button" data-action="increase-place-tension">+1</button>
              </div>
            </div>
          </div>
        </section>

        <section class="tn-panel-card tn-resources-card">
          <div class="tn-section-title">Recursos</div>

          <div class="tn-counter-card tn-counter-card-compact">
            <div class="tn-counter-label">Cigarrillos</div>
            <div class="tn-counter-readout tn-counter-readout-compact">
              <input type="number" data-dtype="Number" name="system.cigarettes.value" value="{{system.cigarettes.value}}" min="0" />
              <span>/</span>
              <input type="number" data-dtype="Number" name="system.cigarettes.max" value="{{system.cigarettes.max}}" min="0" />
            </div>
            <div class="tn-action-grid-2 tn-tight-buttons">
              <button type="button" data-action="spend-cigarette">-1</button>
              <button type="button" data-action="recover-cigarette">+1</button>
              <button type="button" data-action="set-pack-9">Pack 9</button>
              <button type="button" data-action="set-pack-6">Pack 6</button>
            </div>
          </div>

          <div class="tn-counter-card tn-counter-card-compact">
            <div class="tn-counter-label">Reconocimiento</div>
            <div class="tn-rec-readout tn-rec-readout-compact">
              <div>
                <span>Total</span>
                <input type="number" data-dtype="Number" name="system.recognition.total" value="{{system.recognition.total}}" />
              </div>
              <div>
                <span>Gastado</span>
                <input type="number" data-dtype="Number" name="system.recognition.spent" value="{{system.recognition.spent}}" />
              </div>
            </div>
            <p class="tn-small">Disponible: {{availableRecognition}}</p>
            <div class="tn-action-grid-2 tn-tight-buttons">
              <button type="button" data-action="add-recognition">+1</button>
              <button type="button" data-action="spend-recognition">Gastar</button>
            </div>
          </div>

          <div class="tn-control-mini">
            <label>Tragos tranquilos</label>
            <input type="number" data-dtype="Number" name="system.caseStats.quietDrinksUsed" value="{{system.caseStats.quietDrinksUsed}}" min="0" max="2" />
          </div>
        </section>
        <!-- Estados personales se muestran tras Recursos en su propia tarjeta -->
        <section class="tn-panel-card tn-state-card tn-state-card-personal">
          <div class="tn-section-title">Estados personales</div>
          <div class="tn-state-list tn-state-single-col">
            {{#each personalStates as |state|}}
              <label class="tn-check"><input type="checkbox" name="system.personalStates.{{state.id}}" {{checked (lookup ../system.personalStates state.id)}} /> {{state.label}}</label>
            {{/each}}
          </div>
          <div class="tn-inline-fields tn-inline-fields-stacked">
            <input type="text" name="system.personalStates.custom" value="{{system.personalStates.custom}}" placeholder="Estado libre" />
            <label class="tn-check tn-check-inline"><input type="checkbox" name="system.personalStates.customActive" {{checked system.personalStates.customActive}} /> Activo</label>
          </div>
        </section>


        <section class="tn-panel-card tn-gear-card">
          <div class="tn-section-title">Objetos y favores</div>

          <div class="tn-field-grid tn-two-col">
            <div class="tn-compact-box">
              <label>Objeto 1</label>
              <input type="text" name="system.representativeObjects.slot1.name" value="{{system.representativeObjects.slot1.name}}" />
              <label class="tn-check tn-check-inline"><input type="checkbox" name="system.representativeObjects.slot1.used" {{checked system.representativeObjects.slot1.used}} /> Usado</label>
            </div>
            <div class="tn-compact-box">
              <label>Objeto 2</label>
              <input type="text" name="system.representativeObjects.slot2.name" value="{{system.representativeObjects.slot2.name}}" />
              <label class="tn-check tn-check-inline"><input type="checkbox" name="system.representativeObjects.slot2.used" {{checked system.representativeObjects.slot2.used}} /> Usado</label>
            </div>
          </div>

          <div class="tn-field-grid tn-two-col tn-tight-grid">
            <div class="tn-favor-card tn-compact-box">
              <label>Favor 1</label>
              <input type="text" name="system.favors.slot1.name" value="{{system.favors.slot1.name}}" placeholder="Nombre o deuda" />
              <input type="text" name="system.favors.slot1.scope" value="{{system.favors.slot1.scope}}" placeholder="Riesgo / Crimen / Libre" />
              <label class="tn-check tn-check-inline"><input type="checkbox" name="system.favors.slot1.used" {{checked system.favors.slot1.used}} /> Gastado</label>
            </div>
            <div class="tn-favor-card tn-compact-box">
              <label>Favor 2</label>
              <input type="text" name="system.favors.slot2.name" value="{{system.favors.slot2.name}}" placeholder="Nombre o deuda" />
              <input type="text" name="system.favors.slot2.scope" value="{{system.favors.slot2.scope}}" placeholder="Riesgo / Crimen / Libre" />
              <label class="tn-check tn-check-inline"><input type="checkbox" name="system.favors.slot2.used" {{checked system.favors.slot2.used}} /> Gastado</label>
            </div>
          </div>
        </section>

        <section class="tn-panel-card tn-balada-card">
          <div class="tn-section-title">Balada triste</div>
          <div class="tn-field-group">
            <label>¿Qué triste historia has escuchado de...?</label>
            <input type="text" name="system.baladaTarget" value="{{system.baladaTarget}}" />
          </div>
          <div class="tn-field-grid tn-two-col">
            <div class="tn-field-group">
              <label>Rumor</label>
              <textarea class="tn-compact-area" name="system.baladaRumor">{{system.baladaRumor}}</textarea>
            </div>
            <div class="tn-field-group">
              <label class="tn-check tn-check-inline"><input type="checkbox" name="system.baladaBelieve" {{checked system.baladaBelieve}} /> ¿La crees?</label>
              <label>Verdad</label>
              <textarea class="tn-compact-area" name="system.baladaTruth">{{system.baladaTruth}}</textarea>
            </div>
          </div>
        </section>
        <!-- La sección de estados de la ciudad se ubicará tras la Balada triste -->
        <section class="tn-panel-card tn-state-card tn-state-card-city">
          <div class="tn-section-title">Estados de la ciudad</div>
          <div class="tn-state-list tn-state-single-col">
            {{#each cityStates as |state|}}
              <label class="tn-check"><input type="checkbox" name="system.cityStates.{{state.id}}" {{checked (lookup ../system.cityStates state.id)}} /> {{state.label}}</label>
            {{/each}}
          </div>
          <div class="tn-inline-fields tn-inline-fields-stacked">
            <input type="text" name="system.cityStates.custom" value="{{system.cityStates.custom}}" placeholder="Estado libre" />
            <label class="tn-check tn-check-inline"><input type="checkbox" name="system.cityStates.customActive" {{checked system.cityStates.customActive}} /> Activo</label>
          </div>
        </section>

      </div>
    </div>

    <div class="tab tn-tab-investigation" data-group="primary" data-tab="resources">
      <div class="tn-grid tn-investigation-layout">
        <section class="tn-panel-card">
          <div class="tn-section-title">Pistas y contactos</div>
          <div class="tn-field-grid tn-two-col tn-top-gap">
            <div class="tn-clue-count-card">
              <label>Pistas de este detective</label>
              <input type="number" data-dtype="Number" name="system.clues.count" value="{{system.clues.count}}" min="0" />
            </div>
            <div class="tn-rule-pill">Cada 3 pistas del grupo, el dado del crimen baja en 1.</div>
          </div>
          <div class="tn-action-grid-2 tn-top-gap">
            <button type="button" data-action="create-contact">Conozco a un tipo que...</button>
            <button type="button" data-action="create-rumor">Aquí han pasado cosas turbias</button>
          </div>
          {{#if rumorBonusAvailable}}
            <p class="tn-small tn-emphasis tn-top-gap">Rumor pendiente: {{rumorBonusText}}</p>
          {{/if}}
          <div class="tn-field-grid tn-two-col tn-top-gap">
            <div class="tn-field-group">
              <label>Notas de pistas</label>
              <textarea class="tn-mid-area" name="system.clues.notes" placeholder="Secretos, indicios, vínculos...">{{system.clues.notes}}</textarea>
            </div>
            <div class="tn-field-group">
              <label>Contactos y deudas</label>
              <textarea class="tn-mid-area" name="system.contacts.notes" placeholder="PNJ, favores, redirecciones...">{{system.contacts.notes}}</textarea>
            </div>
          </div>
        </section>

        <aside class="tn-panel-card tn-investigation-side">
          <div class="tn-section-title">Ayudas</div>
          <div class="tn-rule-card">
            <h4>Tirada de riesgo</h4>
            <p>1d10. Si un trasfondo aplica, tira 2d10 y quédate el mejor. Cigarrillo o reconocimiento: +2.</p>
          </div>
          <div class="tn-rule-card">
            <h4>Perseguir el crimen</h4>
            <p>Igual que riesgo, pero restando el dado del crimen salvo que uses un objeto representativo.</p>
          </div>
          <div class="tn-rule-card">
            <h4>Cigarrillos</h4>
            <p>1) Conozco a un tipo. 2) Aquí han pasado cosas turbias. 3) Una calada me da la sangre fría.</p>
          </div>
          <div class="tn-rule-card">
            <h4>Un trago tranquilo</h4>
            <p>Recupera 2 cigarrillos o 1 estado personal. Máximo 2 veces por caso.</p>
          </div>
        </aside>
      </div>
    </div>

    <div class="tab tn-tab-notes" data-group="primary" data-tab="notes">
      <section class="tn-panel-card tn-expediente-card">
        <div class="tn-section-title">Expediente del detective</div>
        <textarea class="tn-large-notes" name="system.notes" placeholder="Cronología, sospechosos, hipótesis, escenas clave...">{{system.notes}}</textarea>
      </section>
    </div>
  </section>
</form>
