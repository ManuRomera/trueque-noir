<div class="tn-hoja">
  <fieldset class="tn-fs" {{disabled (not editable)}}>

    {{!-- ═══ Cabecera: quién es y las dos acciones del juego ═══ --}}
    <header class="tn-cabecera">
      <img class="tn-retrato" src="{{actor.img}}" alt="Retrato de {{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="Cambiar el retrato">
      <div class="tn-ident">
        <input class="tn-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre del detective" aria-label="Nombre del detective">
        <div class="tn-ident__fila">
          <input class="tn-rol" type="text" name="system.roleTag" value="{{system.roleTag}}" placeholder="Función o apodo" aria-label="Función o apodo">
          <div class="tn-sellos" aria-label="Estados activos">
            {{#each sellos}}<span class="tn-sello tn-sello--{{kind}}{{#if final}} is-final{{/if}}" {{#if final}}data-tooltip="Abandona la ciudad al terminar el caso."{{/if}}>{{label}}</span>{{/each}}
          </div>
        </div>
      </div>
      <div class="tn-botonera">
        <button type="button" class="tn-accion tn-accion--riesgo" data-action="tirar" data-tipo="risk" data-tooltip="Peligro físico o mental para ti o para el grupo.">
          <i class="fa-solid fa-bolt" aria-hidden="true"></i><span>Riesgo</span>
        </button>
        <button type="button" class="tn-accion tn-accion--crimen" data-action="tirar" data-tipo="pursue" data-tooltip="Una pista a tu alcance: siempre la consigues, pero el crimen cobra su precio.">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span>Perseguir el crimen</span>
        </button>
      </div>
      <div class="tn-herramientas">
        <button type="button" class="tn-icono" data-action="compacto" data-tooltip="{{#if compacto}}Ficha completa{{else}}Modo compacto: una tira estrecha para tenerla siempre a la vista{{/if}}">
          <i class="fa-solid {{#if compacto}}fa-up-right-and-down-left-from-center{{else}}fa-down-left-and-up-right-to-center{{/if}}" aria-hidden="true"></i></button>
        {{#if isGM}}
        <button type="button" class="tn-icono" data-action="abrirPanel" data-tooltip="Panel de La Ciudad"><i class="fa-solid fa-city" aria-hidden="true"></i></button>
        <button type="button" class="tn-icono" data-action="abrirMesa" data-tooltip="Mesa del caso"><i class="fa-solid fa-table-columns" aria-hidden="true"></i></button>
        {{/if}}
      </div>
    </header>

    {{!-- ═══ Tablero: lo que se mira antes de cada tirada ═══ --}}
    <div class="tn-tablero">
      <div class="tn-dato tn-dato--cig" data-tooltip="Cada cigarrillo paga una calada de sangre fría, un contacto, un rumor o una visita nocturna. Clic en uno para dejar la cajetilla en ese número.">
        <span class="tn-etiqueta">Cigarrillos</span>
        <div class="tn-cigs">
          {{#each cigarrillos.casillas}}<button type="button" class="tn-cig{{#if llena}} is-llena{{/if}}" data-action="cigarrillo" data-n="{{n}}" aria-label="Dejar {{n}} cigarrillos"></button>{{/each}}
        </div>
        <span class="tn-valor">{{cigarrillos.valor}}<small>/{{cigarrillos.max}}</small></span>
      </div>

      <div class="tn-dato tn-dato--rec{{#if reconocimiento.negativo}} is-negativo{{/if}}" data-tooltip="Reconocimiento disponible: lo que aún puedes gastar en ayudas (+2) e interludios. Puede quedar en negativo.">
        <span class="tn-etiqueta">Reconocimiento</span>
        <span class="tn-valor">{{reconocimiento.disponible}}</span>
        <span class="tn-mini">
          <button type="button" class="tn-icono tn-icono--xs" data-action="reconocimiento" data-sentido="gastar" data-tooltip="Gastar 1" aria-label="Gastar 1 punto de reconocimiento"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
          <button type="button" class="tn-icono tn-icono--xs" data-action="reconocimiento" data-sentido="ganar" data-tooltip="Ganar 1" aria-label="Ganar 1 punto de reconocimiento"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
        </span>
      </div>

      <div class="tn-dato tn-dato--dado d{{caso.dado}}{{#if caso.explotado}} is-explotado{{/if}}" data-tooltip="Dado del crimen: se resta a Perseguir el Crimen. Baja 1 por cada 3 pistas sin gastar; si sube por encima de 4, el caso se pierde.">
        <span class="tn-etiqueta">Dado del crimen</span>
        <span class="tn-dado">{{#if caso.explotado}}<i class="fa-solid fa-burst" aria-hidden="true"></i>{{else}}{{caso.dado}}{{/if}}</span>
      </div>

      <div class="tn-dato tn-dato--pistas" data-tooltip="Pistas del grupo en este caso. Cada 3 sin gastar bajan el dado del crimen. Hacen falta 6 para acusar.">
        <span class="tn-etiqueta">Pistas del caso</span>
        <span class="tn-valor">{{caso.pistas.total}}</span>
        <span class="tn-pasos" aria-label="{{caso.pistas.progreso}} de 3 hacia bajar el dado">{{#each pistaProgreso}}<i class="tn-paso{{#if llena}} is-llena{{/if}}"></i>{{/each}}</span>
      </div>

      <div class="tn-dato tn-dato--caso">
        <strong class="tn-caso-nombre" title="{{caso.nombre}}">{{caso.nombre}}</strong>
        <span class="tn-caso-tiempo{{#if caso.esNoche}} es-noche{{/if}}">Día {{caso.dia}} de {{caso.limite}} · {{caso.franjaNombre}}</span>
        {{#if rumorActivo}}<span class="tn-caso-rumor" data-tooltip="Hay un rumor pendiente: +2 para una tirada de los compañeros de quien lo contó."><i class="fa-solid fa-comment-dots" aria-hidden="true"></i> Rumor</span>{{/if}}
      </div>
    </div>
  </fieldset>

  {{!-- ═══ Pestañas ═══ --}}
  <nav class="tn-pestanas tabs" aria-label="Secciones de la ficha">
    {{#each tabs}}<a class="tn-pestana{{#if activa}} active{{/if}}" data-action="tab" data-group="primary" data-tab="{{id}}"><i class="{{icon}}" inert></i> <span>{{label}}</span></a>{{/each}}
  </nav>

  <fieldset class="tn-fs tn-cuerpo" {{disabled (not editable)}}>

    {{!-- ───────────── DETECTIVE ───────────── --}}
    <section class="tab tn-juego{{#if (eq tab 'juego')}} active{{/if}}" data-group="primary" data-tab="juego">

      <div class="tn-columna">
        <section class="tn-bloque tn-bloque--fondos">
          <h2 class="tn-titulo">Trasfondos <button type="button" class="tn-ayuda" data-tooltip="Si un trasfondo ayuda en la acción, añades 1d10 y cuentas el mejor. Solo puede ayudar uno por tirada. Se eligen 2; el tercero se compra entre casos." tabindex="-1">?</button></h2>
          <div class="tn-fondos">
            {{#each trasfondos}}
            <div class="tn-campo" {{#if descripcion}}data-tooltip="{{descripcion}}"{{else}}data-tooltip="{{ayuda}}"{{/if}}>
              <label for="tn-bg{{n}}">{{etiqueta}}</label>
              <select id="tn-bg{{n}}" name="{{campo}}">
                <option value="">— Sin elegir —</option>
                {{#each opciones}}<option value="{{b}}" {{#if seleccionada}}selected{{/if}} {{#if bloqueada}}disabled{{/if}}>{{b}}</option>{{/each}}
              </select>
            </div>
            {{/each}}
          </div>
        </section>

        <section class="tn-bloque tn-bloque--pilares">
          <h2 class="tn-titulo">Pilares de estabilidad <button type="button" class="tn-ayuda" data-tooltip="La persona que amas y el lugar que te da paz, siempre dentro de la ciudad. Sobreexponerte repite una tirada a cambio de 1 punto de tensión. A 3, el pilar se rompe y ya no sostiene nada." tabindex="-1">?</button></h2>
          <div class="tn-pilares">
            {{#each pilares}}
            <div class="tn-pilar{{#if roto}} is-roto{{/if}}">
              <label for="tn-p-{{id}}">{{etiqueta}}</label>
              <input id="tn-p-{{id}}" type="text" name="{{campo}}.name" value="{{name}}" placeholder="{{pista}}">
              <div class="tn-tension">
                <span class="tn-pasos tn-pasos--tension" aria-label="Tensión {{tension}} de 3">{{#each casillas}}<i class="tn-paso{{#if llena}} is-llena{{/if}}"></i>{{/each}}</span>
                <span class="tn-tension__texto">{{#if roto}}Roto{{else}}Tensión {{tension}}{{/if}}</span>
                <button type="button" class="tn-icono tn-icono--xs" data-action="tension" data-pilar="{{id}}" data-sentido="bajar" {{#unless tension}}disabled{{/unless}} data-tooltip="Bajar la tensión (interludio o corrección)" aria-label="Bajar la tensión"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                <button type="button" class="tn-icono tn-icono--xs" data-action="tension" data-pilar="{{id}}" data-sentido="subir" {{#if roto}}disabled{{/if}} data-tooltip="Subir la tensión: anota una escena flotante esta noche" aria-label="Subir la tensión"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
              </div>
            </div>
            {{/each}}
          </div>
        </section>

        <section class="tn-bloque tn-bloque--ventajas">
          <h2 class="tn-titulo">Objetos y favores <button type="button" class="tn-ayuda" data-tooltip="Objeto representativo: al perseguir el crimen ignora el dado del crimen, una vez por caso. Favor: éxito automático; se gasta una sola vez y se conserva entre casos. Máximo 2 de cada." tabindex="-1">?</button></h2>
          <div class="tn-ventajas">
            {{#each objetos}}
            <div class="tn-ficha-mini{{#if used}} is-gastada{{/if}}">
              <div class="tn-ficha-mini__fila">
                <i class="fa-solid fa-gem tn-ficha-mini__icono" aria-hidden="true" data-tooltip="Objeto representativo {{n}}: ignora el dado del crimen al perseguir el crimen, una vez por caso."></i>
                <input id="tn-o{{n}}" type="text" name="system.representativeObjects.{{slot}}.name" value="{{name}}" placeholder="Objeto {{n}}: algo que te define" aria-label="Objeto representativo {{n}}">
                <label class="tn-marca tn-marca--solo" data-tooltip="Usado en este caso"><input type="checkbox" name="system.representativeObjects.{{slot}}.used" {{checked used}}><span aria-label="Usado en este caso"></span></label>
              </div>
            </div>
            {{/each}}
            {{#each favores}}
            <div class="tn-ficha-mini{{#if used}} is-gastada{{/if}}">
              <div class="tn-ficha-mini__fila">
                <i class="fa-solid fa-handshake tn-ficha-mini__icono" aria-hidden="true" data-tooltip="Favor {{n}}: éxito automático; se gasta una sola vez y se conserva entre casos."></i>
                <input id="tn-f{{n}}" type="text" name="system.favors.{{slot}}.name" value="{{name}}" placeholder="Favor {{n}}: quién te lo debe" aria-label="Favor {{n}}">
                <label class="tn-marca tn-marca--solo" data-tooltip="Cobrado"><input type="checkbox" name="system.favors.{{slot}}.used" {{checked used}}><span aria-label="Cobrado"></span></label>
              </div>
              <div class="tn-ficha-mini__fila">
                <select name="system.favors.{{slot}}.scope" aria-label="Para qué sirve el favor {{n}}">{{#each alcances}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{t}}</option>{{/each}}</select>
                {{#if name}}<button type="button" class="tn-icono tn-icono--xs tn-icono--quitar" data-action="limpiarFavor" data-slot="{{slot}}" data-tooltip="Borrar este favor" aria-label="Borrar el favor {{n}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}
              </div>
            </div>
            {{/each}}
          </div>
        </section>
      </div>

      <div class="tn-columna">
        <section class="tn-bloque tn-bloque--estados">
          <h2 class="tn-titulo">Estados <button type="button" class="tn-ayuda" data-tooltip="No hay puntos de vida: los estados son la única medida de tu salud y de tu relación con la ciudad. Quebrado y acabado te sacan del juego al terminar el caso." tabindex="-1">?</button></h2>
          <div class="tn-estados-grupo">
            <h3>Personales</h3>
            <div class="tn-estados">
              {{#each estadosPersonales.lista}}<label class="tn-estado{{#if activo}} is-on{{/if}}{{#if final}} is-final{{/if}}"><input type="checkbox" name="system.personalStates.{{id}}" {{checked activo}}><span>{{label}}</span></label>{{/each}}
              <label class="tn-estado tn-estado--libre{{#if estadosPersonales.activoPersonalizado}} is-on{{/if}}"><input type="checkbox" name="system.personalStates.customActive" {{checked estadosPersonales.activoPersonalizado}}><input type="text" name="system.personalStates.custom" value="{{estadosPersonales.personalizado}}" placeholder="Estado libre" aria-label="Estado personal libre"></label>
            </div>
          </div>
          <div class="tn-estados-grupo">
            <h3>Con la ciudad</h3>
            <div class="tn-estados">
              {{#each estadosCiudad.lista}}<label class="tn-estado tn-estado--ciudad{{#if activo}} is-on{{/if}}{{#if final}} is-final{{/if}}"><input type="checkbox" name="system.cityStates.{{id}}" {{checked activo}}><span>{{label}}</span></label>{{/each}}
              <label class="tn-estado tn-estado--ciudad tn-estado--libre{{#if estadosCiudad.activoPersonalizado}} is-on{{/if}}"><input type="checkbox" name="system.cityStates.customActive" {{checked estadosCiudad.activoPersonalizado}}><input type="text" name="system.cityStates.custom" value="{{estadosCiudad.personalizado}}" placeholder="Estado libre" aria-label="Estado con la ciudad libre"></label>
            </div>
          </div>
        </section>

        <section class="tn-bloque tn-bloque--pausa">
          <h2 class="tn-titulo">Un respiro</h2>
          <div class="tn-acciones">
            <button type="button" class="tn-btn" data-action="trago" {{#unless tragos.restantes}}disabled{{/unless}} data-tooltip="Un trago tranquilo: un lugar sin riesgo donde recobras 2 cigarrillos o curas un estado personal, y planteas una hipótesis sobre el caso. Dos por caso.">
              <i class="fa-solid fa-whiskey-glass" aria-hidden="true"></i> Trago <b>{{tragos.restantes}}/2</b></button>
            <button type="button" class="tn-btn" data-action="descanso" data-tooltip="Pasar la noche en tu pilar de estabilidad: recuperas 1 cigarrillo.">
              <i class="fa-solid fa-moon" aria-hidden="true"></i> Descanso</button>
            <button type="button" class="tn-btn" data-action="ceder" data-tooltip="Pasar cigarrillos a un compañero, solo en un momento de sosiego.">
              <i class="fa-solid fa-hand-holding-hand" aria-hidden="true"></i> Ceder</button>
          </div>
        </section>
      </div>
    </section>

    {{!-- ───────────── INVESTIGACIÓN ───────────── --}}
    <section class="tab tn-investigacion{{#if (eq tab 'investigacion')}} active{{/if}}" data-group="primary" data-tab="investigacion">

      <div class="tn-columna">
        <section class="tn-bloque">
          <h2 class="tn-titulo">Pistas</h2>
          <div class="tn-pistas">
            <div class="tn-pistas__grupo">
              <strong>{{caso.pistas.total}}</strong><span>del grupo<br>{{caso.pistas.disponibles}} sin gastar</span>
              <span class="tn-pasos tn-pasos--grande" aria-label="{{caso.pistas.progreso}} de 3 para bajar el dado">{{#each pistaProgreso}}<i class="tn-paso{{#if llena}} is-llena{{/if}}"></i>{{/each}}</span>
            </div>
            <div class="tn-campo tn-campo--num"><label for="tn-pistas">Las tuyas</label><input id="tn-pistas" type="number" data-dtype="Number" name="system.clues.count" value="{{system.clues.count}}" min="0"></div>
          </div>
          <textarea class="tn-notas" name="system.clues.notes" rows="4" placeholder="Indicios, contradicciones, vínculos…" aria-label="Notas de pistas">{{system.clues.notes}}</textarea>
        </section>

        <section class="tn-bloque">
          <h2 class="tn-titulo">Contactos</h2>
          <div class="tn-acciones">
            <button type="button" class="tn-btn tn-btn--contextual" data-action="contacto" {{#unless cigarrillos.valor}}disabled{{/unless}} data-tooltip="Gastas 1 cigarrillo y creas un contacto que siempre tendrá algo que ofrecer."><i class="fa-solid fa-user-tie" aria-hidden="true"></i> Conozco a un tipo que…</button>
            <button type="button" class="tn-btn tn-btn--contextual" data-action="rumor" {{#unless cigarrillos.valor}}disabled{{/unless}} data-tooltip="Gastas 1 cigarrillo y cuentas una historia turbia de un lugar: +2 para una tirada de tus compañeros."><i class="fa-solid fa-comment-dots" aria-hidden="true"></i> Aquí han pasado cosas turbias</button>
          </div>
          {{#if rumorActivo}}<p class="tn-rumor"><i class="fa-solid fa-comment-dots" aria-hidden="true"></i> <strong>Rumor pendiente.</strong> {{caso.rumor.texto}}</p>{{/if}}
          <ul class="tn-contactos">
            {{#each contactos}}
            <li class="tn-contacto{{#if done}} is-hecho{{/if}}">
              <div class="tn-contacto__fila">
                <input type="text" name="system.contacts.list.{{i}}.name" value="{{name}}" placeholder="Nombre" aria-label="Nombre del contacto">
                <button type="button" class="tn-icono tn-icono--xs tn-icono--quitar" data-action="quitarContacto" data-i="{{i}}" data-tooltip="Quitar el contacto" aria-label="Quitar el contacto"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
              </div>
              <div class="tn-contacto__fila">
                <select name="system.contacts.list.{{i}}.zone" aria-label="Zona">
                  <option value="">Zona</option>
                  {{#each ../zonas}}<option value="{{this}}" {{#if (eq this ../zone)}}selected{{/if}}>{{this}}</option>{{/each}}
                </select>
                <input type="text" name="system.contacts.list.{{i}}.place" value="{{place}}" placeholder="Localización" aria-label="Localización">
                <select name="system.contacts.list.{{i}}.offer" aria-label="Qué ofrece" data-tooltip="Pista: tiene una pista que se revela tirando. Ruta: redirige a localizaciones con pistas.">
                  <option value="pista" {{#if (eq offer "pista")}}selected{{/if}}>Pista</option>
                  <option value="ruta" {{#if (eq offer "ruta")}}selected{{/if}}>Ruta</option>
                </select>
                <label class="tn-marca" data-tooltip="Ya le sacaste lo que tenía"><input type="checkbox" name="system.contacts.list.{{i}}.done" {{checked done}}><span>Hecho</span></label>
              </div>
            </li>
            {{else}}
            <li class="tn-vacio">Sin contactos todavía.</li>
            {{/each}}
          </ul>
          <button type="button" class="tn-btn tn-btn--ghost tn-btn--bajo" data-action="anadirContacto"><i class="fa-solid fa-plus" aria-hidden="true"></i> Añadir a mano</button>
        </section>
      </div>

      <div class="tn-columna tn-columna--ancha">
        <section class="tn-bloque tn-bloque--expediente">
          <h2 class="tn-titulo">Expediente</h2>
          <div class="tn-expediente">
            <div class="tn-nota"><label for="tn-e1">Cronología</label><textarea id="tn-e1" name="system.dossier.timeline" placeholder="Qué ocurrió y cuándo…">{{system.dossier.timeline}}</textarea></div>
            <div class="tn-nota"><label for="tn-e2">Sospechosos</label><textarea id="tn-e2" name="system.dossier.suspects" placeholder="Quién pudo hacerlo y por qué…">{{system.dossier.suspects}}</textarea></div>
            <div class="tn-nota"><label for="tn-e3">Hipótesis</label><textarea id="tn-e3" name="system.dossier.hypotheses" placeholder="Lo que crees que pasó…">{{system.dossier.hypotheses}}</textarea></div>
            <div class="tn-nota"><label for="tn-e4">Escenas importantes</label><textarea id="tn-e4" name="system.dossier.scenes" placeholder="Lo que no quieres olvidar…">{{system.dossier.scenes}}</textarea></div>
          </div>
        </section>
      </div>
    </section>

    {{!-- ───────────── HISTORIA ───────────── --}}
    <section class="tab tn-historia{{#if (eq tab 'historia')}} active{{/if}}" data-group="primary" data-tab="historia">
      <div class="tn-columna">
        <section class="tn-bloque">
          <h2 class="tn-titulo">Quién es</h2>
          <div class="tn-rejilla">
            <div class="tn-campo"><label for="tn-look">¿Cómo eres físicamente?</label><input id="tn-look" type="text" name="system.look" value="{{system.look}}"></div>
            <div class="tn-campo"><label for="tn-belief">¿En qué crees?</label><input id="tn-belief" type="text" name="system.belief" value="{{system.belief}}" placeholder="En Dios, en la bondad o en la decadencia"></div>
            <div class="tn-campo"><label for="tn-temper">¿Cómo es tu carácter?</label><input id="tn-temper" type="text" name="system.temperament" value="{{system.temperament}}"></div>
            <div class="tn-campo tn-campo--corto"><label for="tn-age">Edad</label><input id="tn-age" type="text" name="system.age" value="{{system.age}}"></div>
            <div class="tn-campo tn-campo--ancho"><label for="tn-motivation">Motivación para seguir siendo detective en esta ciudad</label><input id="tn-motivation" type="text" name="system.motivation" value="{{system.motivation}}"></div>
          </div>
        </section>
        <section class="tn-bloque">
          <h2 class="tn-titulo">Notas generales</h2>
          <textarea class="tn-notas tn-notas--alta" name="system.notes" placeholder="Todo lo demás…" aria-label="Notas generales">{{system.notes}}</textarea>
        </section>
        <details class="tn-bloque tn-ajuste" data-memoria="ajuste" {{#if ajusteAbierto}}open{{/if}}>
          <summary class="tn-titulo">Corregir cajetilla y reconocimiento</summary>
          <p class="tn-pista">Para corregir los números a mano. En juego se mueven solos.</p>
          <div class="tn-rejilla tn-rejilla--4">
            <div class="tn-campo"><label for="tn-cv">Cigarrillos</label><input id="tn-cv" type="number" data-dtype="Number" name="system.cigarettes.value" value="{{system.cigarettes.value}}" min="0"></div>
            <div class="tn-campo"><label for="tn-cm">Cajetilla</label><input id="tn-cm" type="number" data-dtype="Number" name="system.cigarettes.max" value="{{system.cigarettes.max}}" min="0"></div>
            <div class="tn-campo"><label for="tn-rt">Reconocimiento</label><input id="tn-rt" type="number" data-dtype="Number" name="system.recognition.total" value="{{system.recognition.total}}"></div>
            <div class="tn-campo"><label for="tn-rs">Gastado</label><input id="tn-rs" type="number" data-dtype="Number" name="system.recognition.spent" value="{{system.recognition.spent}}" min="0"></div>
          </div>
          <div class="tn-acciones">
            <button type="button" class="tn-btn tn-btn--ghost" data-action="cajetilla" data-max="9" data-tooltip="Con 2 detectives en el grupo">Cajetilla de 9</button>
            <button type="button" class="tn-btn tn-btn--ghost" data-action="cajetilla" data-max="6" data-tooltip="Con 3 detectives en el grupo">Cajetilla de 6</button>
            <div class="tn-campo tn-campo--num"><label for="tn-qd">Tragos tomados</label><input id="tn-qd" type="number" data-dtype="Number" name="system.caseStats.quietDrinksUsed" value="{{system.caseStats.quietDrinksUsed}}" min="0" max="2"></div>
          </div>
        </details>
      </div>
      <div class="tn-columna">
        <section class="tn-bloque tn-bloque--papel">
          <h2 class="tn-titulo">Balada triste <button type="button" class="tn-ayuda" data-tooltip="Un compañero cuenta una historia turbia que ha oído de ti y si la cree. No tiene efecto mecánico: es un gancho narrativo. En privado, anota cuál es la verdad." tabindex="-1">?</button></h2>
          <div class="tn-campo"><label for="tn-balada-target">¿De quién has oído una triste historia?</label><input id="tn-balada-target" type="text" name="system.baladaTarget" value="{{system.baladaTarget}}" placeholder="El compañero que la cuenta sobre ti"></div>
          <div class="tn-campo"><label for="tn-balada-rumor">Lo que se cuenta de ti</label><textarea id="tn-balada-rumor" name="system.baladaRumor" rows="2">{{system.baladaRumor}}</textarea></div>
          <div class="tn-campo"><label for="tn-balada-truth">La verdad (solo para ti)</label><textarea id="tn-balada-truth" name="system.baladaTruth" rows="2">{{system.baladaTruth}}</textarea></div>
          <label class="tn-marca"><input type="checkbox" name="system.baladaBelieve" {{checked system.baladaBelieve}}><span>Quien la contó cree que es cierta</span></label>
        </section>
      </div>
    </section>

  </fieldset>
</div>
