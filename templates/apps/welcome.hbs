<div class="tn-welcome">
  <header class="tn-welcome__hero" style="background-image: linear-gradient(to bottom, rgba(8,9,11,.2), rgba(8,9,11,.96)), url('{{cover}}');">
    <img class="tn-welcome__logo" src="{{logo}}" alt="Trueque Noir">
    <p class="tn-welcome__tagline">La ciudad no duerme: solo cierra los ojos mientras alguien paga el precio.</p>
  </header>

  <div class="tn-welcome__body">
    <div class="tn-welcome__steps">
      {{#if isGM}}
      <button type="button" class="tn-step{{#if cityReady}} is-done{{/if}}" data-action="ciudad">
        <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
        <strong>1 · Construir la ciudad</strong>
        <small>{{#if cityReady}}{{cityName}} está en pie · editar{{else}}Contexto, cuatro zonas y localizaciones{{/if}}</small>
      </button>
      {{/if}}
      <button type="button" class="tn-step{{#if detectiveCount}} is-done{{/if}}" data-action="detective">
        <i class="fa-solid fa-user-secret" aria-hidden="true"></i>
        <strong>{{#if isGM}}2{{else}}1{{/if}} · Crear detectives</strong>
        <small>{{#if detectiveCount}}{{detectiveCount}} en la ciudad · crear otro{{else}}Identidad, objetos, pilares y balada{{/if}}</small>
      </button>
      {{#if isGM}}
      <button type="button" class="tn-step" data-action="caso">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
        <strong>3 · Empezar un caso</strong>
        <small>Panel de La Ciudad: tiempo, crimen y pistas</small>
      </button>
      {{/if}}
    </div>

    {{#if isGM}}
    {{#if archiveCount}}
    <button type="button" class="tn-welcome__archive" data-action="casos">
      <i class="fa-solid fa-folder-tree" aria-hidden="true"></i>
      <span>{{#if archiveImported}}Revisar{{else}}Explorar{{/if}} los {{archiveCount}} casos del archivo</span>
      <small>Material de aventura de sus autores. Se importa como diarios privados solo si lo pides.</small>
    </button>
    {{/if}}
    {{/if}}

    <footer class="tn-welcome__foot">
      {{#if isGM}}
      <label class="tn-switch"><input type="checkbox" name="hideOnStart" {{#if hideOnStart}}checked{{/if}}><span>No abrir esta pantalla al iniciar</span></label>
      {{/if}}
      <p class="tn-welcome__hint">Vuelve aquí desde el menú <strong>Trueque Noir</strong> de los controles de escena.</p>
    </footer>
  </div>
</div>
