<div class="tn-board">
  <div class="tn-board__case">
    <span class="tn-kicker">Mesa del caso</span>
    <h1 class="tn-board__name">{{caseName}}</h1>
    <p class="tn-board__time"><strong>Día {{day}}</strong> de {{timeLimit}} · {{phase}}</p>
  </div>

  <div class="tn-board__crime {{#if exploded}}is-exploded{{/if}}">
    <span class="tn-board__crime-label">Dado del crimen</span>
    <span class="tn-board__crime-value">{{crimeDie}}</span>
    {{#if exploded}}<span class="tn-board__crime-boom">Ha explotado</span>{{/if}}
  </div>

  <div class="tn-board__clues">
    <div class="tn-board__clue">
      <strong>{{clueTotal}}</strong>
      <span>pistas descubiertas</span>
    </div>
    <div class="tn-board__clue is-key">
      <strong>{{clueAvailable}}</strong>
      <span>sin gastar · {{cluesPerStep}} bajan el dado</span>
    </div>
    {{#if rumorBonusAvailable}}
      <div class="tn-board__rumor">
        <span class="tn-rumor__kicker">Rumor pendiente</span>
        <p>{{rumorBonusText}}</p>
      </div>
    {{/if}}
  </div>
</div>
