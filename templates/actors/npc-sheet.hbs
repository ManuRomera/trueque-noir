<div class="tn-hoja tn-hoja--pnj">
  <fieldset class="tn-fs" {{disabled (not editable)}}>
    <header class="tn-cabecera">
      <img class="tn-retrato" src="{{actor.img}}" alt="Retrato de {{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="Cambiar el retrato">
      <div class="tn-ident">
        <input class="tn-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre del PNJ" aria-label="Nombre del PNJ">
        <input class="tn-rol" type="text" name="system.role" value="{{system.role}}" placeholder="Rol en la ciudad" aria-label="Rol del PNJ">
      </div>
    </header>
    <div class="tn-cuerpo tn-cuerpo--pnj">
      <div class="tn-rejilla tn-rejilla--3">
        <div class="tn-campo">
          <label for="tn-npc-zone">Zona</label>
          <select id="tn-npc-zone" name="system.zone">
            <option value="">—</option>
            {{#each zonas}}<option value="{{this}}" {{#if (eq this ../system.zone)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select>
        </div>
        <div class="tn-campo"><label for="tn-npc-location">Localización</label><input id="tn-npc-location" type="text" name="system.location" value="{{system.location}}"></div>
        <div class="tn-campo">
          <label for="tn-npc-favor">Favor que puede deber</label>
          <select id="tn-npc-favor" name="system.favorScope">
            <option value="" {{#unless system.favorScope}}selected{{/unless}}>Ninguno</option>
            <option value="libre" {{#if (eq system.favorScope "libre")}}selected{{/if}}>Cualquier tirada</option>
            <option value="riesgo" {{#if (eq system.favorScope "riesgo")}}selected{{/if}}>Solo riesgo</option>
            <option value="crimen" {{#if (eq system.favorScope "crimen")}}selected{{/if}}>Solo perseguir el crimen</option>
          </select>
        </div>
      </div>
      <div class="tn-campo">
        <label for="tn-npc-notes">Notas · qué sabe, qué quiere, qué esconde</label>
        <textarea id="tn-npc-notes" class="tn-notas tn-notas--alta" name="system.notes" placeholder="Doble moral y motivaciones ocultas: cada PNJ tiene una vida más allá del caso.">{{system.notes}}</textarea>
      </div>
    </div>
  </fieldset>
</div>
