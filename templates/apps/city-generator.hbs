<div class="tn-wizard">
  <header class="tn-wizard__head">
    <div>
      <span class="tn-kicker">Asistente</span>
      <h1>Construir la ciudad</h1>
    </div>
    <button type="button" class="tn-btn tn-btn--ghost" data-action="azar" data-tooltip="Una propuesta completa con las tablas de la ambientación elegida."><i class="fa-solid fa-dice" aria-hidden="true"></i> Generar propuesta al azar</button>
  </header>

  <ol class="tn-stepper">
    <li><button type="button" data-action="irPaso" data-paso="1"><span>1</span> Contexto</button></li>
    <li><button type="button" data-action="irPaso" data-paso="2"><span>2</span> Zonas</button></li>
    <li><button type="button" data-action="irPaso" data-paso="3"><span>3</span> Localizaciones</button></li>
    <li><button type="button" data-action="irPaso" data-paso="4"><span>4</span> Resumen</button></li>
  </ol>

  <div class="tn-wizard__form">

    <section data-paso="1" class="tn-wizard__step">
      <h2 class="tn-wizard__q">Contexto y límites <small>Se hace con calma: de aquí depende que todos se sientan a gusto.</small></h2>
      <div class="tn-rejilla">
        <div class="tn-campo" data-tooltip="Decide el fondo de la escena de portada y las tablas de la generación aleatoria: nombres, zonas, quién manda y qué lleva encima un detective de ese mundo.">
          <label for="tn-city-theme">Ambientación</label>
          <select id="tn-city-theme" name="theme">{{{themeOptions}}}</select>
        </div>
        <div class="tn-campo"><label for="tn-city-name">Nombre de la ciudad</label><input id="tn-city-name" name="cityName" type="text" autofocus></div>
        <div class="tn-campo tn-campo--ancho"><label for="tn-city-context">Año, lugar y temática</label><textarea id="tn-city-context" name="context" rows="2"></textarea></div>
        <div class="tn-campo"><label for="tn-city-wanted">Queremos ver</label><textarea id="tn-city-wanted" name="wanted" rows="2"></textarea></div>
        <div class="tn-campo"><label for="tn-city-unwanted">No queremos ver</label><textarea id="tn-city-unwanted" name="unwanted" rows="2"></textarea></div>
      </div>
      <div class="tn-wizard__actions"><span></span><button type="button" class="tn-btn tn-btn--primary" data-action="irPaso" data-paso="2">Siguiente</button></div>
    </section>

    <section data-paso="2" class="tn-wizard__step" hidden>
      <h2 class="tn-wizard__q">Las cuatro zonas <small>Nombre, dos rasgos y quién manda en cada una.</small></h2>
      {{#each zones}}
      <fieldset class="tn-zone-form">
        <legend>{{this}}</legend>
        <div class="tn-rejilla tn-rejilla--3">
          <div class="tn-campo"><label>Nombre</label><input name="{{lowercase this}}Name" type="text"></div>
          <div class="tn-campo"><label>Dos rasgos</label><input name="{{lowercase this}}Traits" type="text"></div>
          <div class="tn-campo"><label>Quién controla</label><input name="{{lowercase this}}Controller" type="text"></div>
        </div>
      </fieldset>
      {{/each}}
      <div class="tn-wizard__actions"><button type="button" class="tn-btn" data-action="irPaso" data-paso="1">Atrás</button><button type="button" class="tn-btn tn-btn--primary" data-action="irPaso" data-paso="3">Siguiente</button></div>
    </section>

    <section data-paso="3" class="tn-wizard__step" hidden>
      <h2 class="tn-wizard__q">Localizaciones <small>Las catorce comunes ya existen; añade una propia en cada zona.</small></h2>
      <div class="tn-chips" data-locations>{{#each commonLocations}}<span class="tn-chip">{{this}}</span>{{/each}}</div>
      <div class="tn-rejilla tn-rejilla--4">
        {{#each zones}}<div class="tn-campo"><label>Propia de {{this}}</label><input name="{{lowercase this}}Extra" type="text" placeholder="Un parque, un gimnasio…"></div>{{/each}}
      </div>
      <div class="tn-wizard__actions"><button type="button" class="tn-btn" data-action="irPaso" data-paso="2">Atrás</button><button type="button" class="tn-btn tn-btn--primary" data-action="irPaso" data-paso="4">Ver el resumen</button></div>
    </section>

    <section data-paso="4" class="tn-wizard__step" hidden>
      <h2 class="tn-wizard__q">Resumen de la ciudad</h2>
      <div class="tn-summary" data-summary></div>
      <label class="tn-switch tn-wizard__apply"><input type="checkbox" name="applyScene" checked><span>Aplicar esta ambientación a la escena de portada</span></label>
      <p class="tn-wizard__warning" data-aviso hidden>Falta el nombre de la ciudad: vuelve al primer paso.</p>
      <div class="tn-wizard__actions"><button type="button" class="tn-btn" data-action="irPaso" data-paso="3">Atrás</button><button type="button" class="tn-btn tn-btn--primary" data-action="crear" data-boton-crear><i class="fa-solid fa-city" aria-hidden="true"></i> Guardar la ciudad</button></div>
    </section>

  </div>
</div>
